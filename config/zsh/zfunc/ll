#!/usr/bin/env zsh

# Per-tool listing variants — defined only when the tool is present.
if (( $+commands[lsd] )); then
    __ll_lsd() {
        prepend " " < <(lsd -Ahl --group-directories-first --color=always)
    }
fi

if (( $+commands[eza] )); then
    __ll_eza() {
        prepend " " < <(eza -Ahl \
                --colour=always \
                --group-directories-first \
                --icons=always \
                --no-user \
                --sort=Name \
                --time-style=+'%d-%m-%y %H:%M' \
                --color-scale=age \
                --ignore-glob='*.DS_Store|.php-cs-fixer.cache|.phpunit.result.cache|.wakatime*|.*history|.*hst*|.yarnrc|hushlogin|.hushlogin|.rnd|.fasd|.viminfo|.Xauthority|.z|mysqladmin|.CFUserTextEncoding|.angular-config.json|.zprofrc|.lolmsgrc|.ztimingrc|.zpromptcacherc')
    }
fi

if (( $+commands[lla] )); then
    __ll_lla() {
        prepend " " < <(lla -Ahl --group-directories-first --color=always)
    }
fi

__ll_raw() {
    local ls_args=${LS_DEFAULT_ARGS:--Ahl}
    prepend "  " < <(ls ${=ls_args})
}

# Self-redefine ll to the resolved variant on first call.
# All subsequent calls bypass this dispatch entirely.
() {
    local _cmd=${LS_OVERRIDE:-ls}
    if   [[ $_cmd == lsd ]] && (( ${+functions[__ll_lsd]} )); then
        ll() { __ll_lsd "$@" }
    elif [[ $_cmd == eza ]] && (( ${+functions[__ll_eza]} )); then
        ll() { __ll_eza "$@" }
    elif [[ $_cmd == lla ]] && (( ${+functions[__ll_lla]} )); then
        ll() { __ll_lla "$@" }
    else
        ll() { __ll_raw "$@" }
    fi
}

ll "$@"
